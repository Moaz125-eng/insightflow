ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5080
JWT_SECRET=replace-with-32-char-minimum-secret-key
JWT_ISSUER=InsightFlow
JWT_AUDIENCE=InsightFlowClients
STORAGE_ROOT=./data/uploads
DATABASE_PATH=./data/insightflow.db
ONNX_MODEL_PATH=./models/embedding.onnx
OCR_TESSDATA_PATH=./models/tessdata
LOG_LEVEL=Information
RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=20
